# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# External dataset (JSON 산출물, git 제외) – SQL 템플릿은 추적
data/dataset/

# Oracle 실행용 SQL (환경별 커스텀) – 템플릿은 data/sql.example/ 추적
data/sql/*
!data/sql/.gitkeep

# Trained models (large binary files – checkpoints/best 등 하위 경로 포함)
# 단, 배포용 최종 모델 1개와 그 수렴 리포트는 추적한다 — 코드만 받아서는
# 재현에 CPU 40분+가 걸려서, 바로 추론에 쓸 수 있는 기준 모델을 함께 둔다.
# FAC별 모델(models/{FAC_ID}/)·체크포인트·best는 그대로 제외.
models/**
!models/.gitkeep
!models/scheduling_rl.zip
!models/training_convergence_scheduling_rl.png
!models/training_history_scheduling_rl.json

# IDE
.vscode/
.idea/

# Logs & temp
*.log
logs/
logging/
.env
config/databases.yaml
config/databases.prd.yaml
config/databases.dev.yaml
frontend/node_modules/
frontend/dist/

# 실험 산출물 (재현 가능, chat로 보고)
experiment_results.json
experiment_results_v2.json
