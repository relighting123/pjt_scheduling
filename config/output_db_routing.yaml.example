# config/output_db_routing.yaml.example → 복사: config/output_db_routing.yaml
#
# 출력(RTS_*) 테이블 중 일부만 다른 DB에 적재하고 싶을 때만 사용하는 선택
# 파일입니다. 이 파일이 아예 없거나, 어떤 테이블이 여기 적혀 있지 않으면
# 그 테이블은 그대로 --db/db_alias 인자(또는 databases.yaml의 default)를
# 씁니다 — 즉 다른 DB로 보낼 테이블만 적으면 됩니다.
#
# 테이블명은 대소문자 구분 없이 인식됩니다. alias는 config/databases.yaml
# 에 정의된 것과 같은 값을 씁니다.

RTS_PERFMON_HIS: Dev
RTS_VALIDATION: Dev

# RTS_RSLT_MAS / RTS_RSLT_HIS / RTS_EQPCONVPLAN_INF / RTS_EQPCONVPLAN_HIS 는
# 여기 없으므로 계속 --db/db_alias 인자를 그대로 씁니다.
